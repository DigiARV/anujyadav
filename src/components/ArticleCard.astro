---
import Arrow from './Arrow.astro';
import type { articles } from '../data/articles';
interface Props {
  article: (typeof articles)[number];
  index: number;
}
const { article, index } = Astro.props;
---

<article class="article-card" data-category={article.category} data-type={article.type}>
  <a href={`/insights/${article.slug}/`} class="article-art-link" tabindex="-1" aria-hidden="true">
    <div class:list={['article-art', article.color]}>
      <span class="art-index">FIELD NOTES / 0{index + 1}</span>
      <div class={`art-shape shape-${index % 3}`}>
        <i></i>
        <i></i>
        <i></i>
      </div>
      <span class="art-caption">{article.category}</span>
      <span class="art-arrow">
        <Arrow />
      </span>
    </div>
  </a>
  <div class="article-meta">
    <span>{article.category}</span>
    <span>{article.read}</span>
  </div>
  <h3>
    <a href={`/insights/${article.slug}/`}>{article.title}</a>
  </h3>
  <p>{article.excerpt}</p>
</article>
