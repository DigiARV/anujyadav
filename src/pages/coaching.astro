---
import Arrow from '../components/Arrow.astro';
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';
import { services } from '../data/site';
const coaching = [services[2], services[3], services[6]];
---

<Layout
  title="Coaching & Consulting"
  description="Explore business strategy, leadership coaching, and one-to-one clarity sessions with Anuj Yadav. A practical space to think through your next step."
>
  <section class="container page-hero">
    <p class="eyebrow">COACHING & CONSULTING</p>
    <h1>
      Room to think.
      <br />
      <em>Clarity to move.</em>
    </h1>
    <p class="lead">
      When everything feels important, a focused conversation can help you find the question that
      deserves your attention.
    </p>
    <a class="button" href="/contact/?interest=Individual%20coaching#enquire">
      Explore a conversation <Arrow />
    </a>
  </section>
  <section class="container service-details">
    {coaching.map((s, i) => (
      <article class="service-detail" id={['business', 'leadership', 'individual'][i]}>
        <div>
          <p class="eyebrow">
            0{i + 1} / {s.title}
          </p>
          <h2>{s.short}</h2>
          <p>{s.description}</p>
          <a
            class="text-link"
            href={`/contact/?interest=${encodeURIComponent(['Business coaching', 'Leadership coaching', 'Individual coaching'][i])}#enquire`}
          >
            {s.cta} <Arrow />
          </a>
        </div>
        <div>
          <p class="eyebrow">FOR YOU, IF YOU’RE</p>
          <p>{s.audience}</p>
          <ul class="clean-list">
            {s.topics.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
          <p class="micro">{s.formats}</p>
        </div>
      </article>
    ))}
  </section>
  <section class="principles-section">
    <div class="container section">
      <p class="eyebrow">HOW IT BEGINS</p>
      <h2>
        No one-size-fits-all plan.
        <br />
        <em>A conversation first.</em>
      </h2>
      <div class="three-columns">
        <div>
          <h3>01. Share the context.</h3>
          <p>Tell us what you are working through and what you want to change.</p>
        </div>
        <div>
          <h3>02. Explore the fit.</h3>
          <p>Discuss the goal, the approach, and whether this is the right kind of support.</p>
        </div>
        <div>
          <h3>03. Agree the next step.</h3>
          <p>Confirm the scope, format, fees, and expectations before an engagement begins.</p>
        </div>
      </div>
      <p class="micro">
        Professional coaching and consulting are not a substitute for mental health, legal, medical,
        or financial advice.
      </p>
    </div>
  </section>
  <CTA
    title="What’s on your mind?"
    description="Bring the challenge, the question, or the ambition. Start with a little context."
    href="/contact/?interest=Individual%20coaching#enquire"
    label="Enquire about coaching"
  />
</Layout>
