>
  <section class="container page-hero not-found">
    <p class="eyebrow">404 / A SMALL DETOUR</p>
    <h1>
      Let’s find
      <br />
      <em>your way forward.</em>
    </h1>
    <p class="lead">This page doesn’t exist, or it may have moved.</p>
    <a class="button" href="/">
      Back to home <Arrow />
    </a>
    <a class="text-link" href="/services/">
      Explore ways to work together <Arrow />
    </a>
  </section>
</Layout>
