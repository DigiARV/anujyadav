---
import Arrow from '../components/Arrow.astro';
import Layout from '../layouts/Layout.astro';
import Portrait from '../components/Portrait.astro';
import CTA from '../components/CTA.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { articles } from '../data/articles';
---

<Layout
  title="Speaking, coaching & a practical path to growth"
  description="Explore speaking, corporate training, coaching, and AI education with Anuj Yadav. Clearer thinking and practical next steps for people and businesses."
>
  <section class="hero container">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="status-dot"></span> BUSINESS GROWTH · LEADERSHIP · AI
      </p>
      <h1>
        Potential is
        <br />a beginning.
        <br />
        <em>
          Progress is
          <br class="desktop-break" /> a practice.
        </em>
      </h1>
      <p class="hero-description">
        I’m Anuj Yadav—a coach, speaker, and entrepreneur. I help professionals, teams, and
        businesses move forward through clearer strategy, stronger leadership, and practical
        learning.
      </p>
      <div class="hero-actions">
        <a class="button" href="/speaking/#enquire">
          Invite Anuj to speak{' '}
          <span aria-hidden="true">
            <Arrow />
          </span>
        </a>
        <a class="text-link" href="/services/">
          Let’s work together{' '}
          <span aria-hidden="true">
            <Arrow />
          </span>
        </a>
      </div>
      <div class="hero-footnote">
        <span>COACH · SPEAKER · ENTREPRENEUR</span>
        <a href="#perspective" aria-label="Scroll to explore Anuj’s approach">
          SCROLL TO EXPLORE ↓
        </a>
      </div>
    </div>
    <div class="hero-visual">
      <span class="vertical-label" aria-hidden="true">
        A LITTLE CLARITY CAN CHANGE WHAT COMES NEXT.
      </span>
      <Portrait />
      <div class="hero-visual-tag">
        <span class="tiny-star" aria-hidden="true">
          <svg width="1em" height="1em" viewBox="0 0 40 40" aria-hidden="true">
            <path d="M20 2v36M2 20h36M7 7l26 26M7 33 33 7" stroke="currentColor" stroke-width="3" />
          </svg>
        </span>
        <span>
          Human potential.
          <br />
          Practical progress.
        </span>
      </div>
    </div>
  </section>
  <div class="expertise-strip">
    <div class="container">
      <span>BUSINESS GROWTH</span>
      <i>
        <svg width="1em" height="1em" viewBox="0 0 40 40" aria-hidden="true">
          <path d="M20 2v36M2 20h36M7 7l26 26M7 33 33 7" stroke="currentColor" stroke-width="3" />
        </svg>
      </i>
      <span>LEADERSHIP</span>
      <i>
        <svg width="1em" height="1em" viewBox="0 0 40 40" aria-hidden="true">
          <path d="M20 2v36M2 20h36M7 7l26 26M7 33 33 7" stroke="currentColor" stroke-width="3" />
        </svg>
      </i>
      <span>AI & DIGITAL EDUCATION</span>
      <i>
        <svg width="1em" height="1em" viewBox="0 0 40 40" aria-hidden="true">
          <path d="M20 2v36M2 20h36M7 7l26 26M7 33 33 7" stroke="currentColor" stroke-width="3" />
        </svg>
      </i>
      <span>PERSONAL BRANDING</span>
    </div>
  </div>
  <section class="section container intro-grid" id="perspective">
    <p class="eyebrow section-index">01 / THE CONNECTING THREAD</p>
    <div>
      <h2>
        Growth isn’t one thing.
        <br />
        <span class="muted">It starts with the right next thing.</span>
      </h2>
      <div class="intro-bottom">
        <p>
          A clearer direction for your business. A more confident voice as a leader. A new way to
          use technology. My work brings strategy, learning, and human development into the same
          conversation.
        </p>
        <a class="text-link" href="/about/">
          Meet Anuj{' '}
          <span aria-hidden="true">
            <Arrow />
          </span>
        </a>
      </div>
    </div>
  </section>
  <section class="section container pathways">
    <div class="section-heading">
      <div>
        <p class="eyebrow">02 / FIND YOUR STARTING POINT</p>
        <h2>
          Where are you
          <br />
          <em>headed next?</em>
        </h2>
      </div>
      <p>
        Different ambitions.
        <br />A shared intention to move forward.
      </p>
    </div>
    <div class="pathway-grid">
      {[
        ['Organizations', 'Build a team ready for what’s next.', '/corporate-training/'],
        ['Professionals', 'Grow your confidence and influence.', '/coaching/#leadership'],
        ['Entrepreneurs', 'Bring clarity to your next stage.', '/coaching/#business'],
        ['Creators', 'Make your expertise more visible.', '/services/#personal-branding'],
      ].map(([title, text, href], i) => (
        <a class="pathway" href={href}>
          <span class="pathway-number">0{i + 1}</span>
          <h3>{title}</h3>
          <p>{text}</p>
          <span class="pathway-arrow" aria-hidden="true">
            <Arrow />
          </span>
        </a>
      ))}
    </div>
  </section>
  <section class="speaking-feature">
    <div class="container speaking-feature-grid">
      <div class="speaking-art" aria-hidden="true">
        <span class="eyebrow">A ROOM FULL OF POSSIBILITY.</span>
        <div class="sound-rings">
          <i></i>
          <i></i>
          <i></i>
          <i></i>
        </div>
        <span class="speaking-art-bottom">
          ONE IDEA CAN
          <br />
          <em>start a conversation.</em>
        </span>
      </div>
      <div class="speaking-feature-copy">
        <p class="eyebrow">03 / INVITE A FRESH PERSPECTIVE</p>
        <h2>
          A moment on stage.
          <br />
          <em>
            A thought that
            <br />
            stays with you.
          </em>
        </h2>
        <p>
          Thoughtful conversations about leadership, growth, and a changing world of work. Shaped
          around your audience. Grounded in what they can do next.
        </p>
        <div class="topic-tags">
          <span>Leadership & influence</span>
          <span>AI & the future of work</span>
          <span>Growth & entrepreneurship</span>
        </div>
        <a class="button button-light" href="/speaking/">
          Explore keynote speaking{' '}
          <span aria-hidden="true">
            <Arrow />
          </span>
        </a>
        <p class="micro">For conferences, corporate events, and leadership offsites.</p>
      </div>
    </div>
  </section>
  <section class="section container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">04 / IDEAS INTO ACTION</p>
        <h2>
          Let’s make
          <br />
          <em>progress practical.</em>
        </h2>
      </div>
      <a class="text-link" href="/services/">
        All ways to work together <Arrow />
      </a>
    </div>
    <div class="service-list">
      {[
        [
          '01',
          'Build capability together.',
          'Corporate training & workshops',
          'Hands-on learning for stronger communication, leadership, and everyday effectiveness.',
          '/corporate-training/',
        ],
        [
          '02',
          'Find your next move.',
          'Coaching & consulting',
          'A thinking partner for business strategy, leadership, and professional growth.',
          '/coaching/',
        ],
        [
          '03',
          'Stay curious. Stay relevant.',
          'AI & digital education',
          'Practical learning at the intersection of technology, business, and human potential.',
          '/education/',
        ],
      ].map(([number, title, label, desc, href]) => (
        <a class="service-row" href={href}>
          <span class="row-number">{number}</span>
          <div>
            <span class="eyebrow">{label}</span>
            <h3>{title}</h3>
          </div>
          <p>{desc}</p>
          <span class="round-arrow" aria-hidden="true">
            <Arrow />
          </span>
        </a>
      ))}
    </div>
  </section>
  <section class="ventures-section">
    <div class="container ventures-inner">
      <div>
        <p class="eyebrow">THE WORK TAKES DIFFERENT FORMS</p>
        <h2>
          One perspective.
          <br />
          Connected ventures.
        </h2>
      </div>
      <div class="venture">
        <h3>DigiARV</h3>
        <p>Digital marketing, AI-enabled business solutions, and digital education.</p>
      </div>
      <div class="venture">
        <h3>NourishNudge</h3>
        <p>Coaching, communication, soft skills, and professional development.</p>
      </div>
    </div>
  </section>
  <section class="section container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">05 / NOTES FOR THE JOURNEY</p>
        <h2>
          A little perspective.
          <br />
          <em>Something to work with.</em>
        </h2>
      </div>
      <a class="text-link" href="/insights/">
        Explore all insights <Arrow />
      </a>
    </div>
    <div class="article-grid">
      {articles.map((article, index) => (
        <ArticleCard article={article} index={index} />
      ))}
    </div>
  </section>
  <CTA href="/speaking/#enquire" label="Invite Anuj to speak" />
</Layout>
